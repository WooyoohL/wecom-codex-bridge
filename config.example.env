# 复制本文件为 config.local.env，然后在 config.local.env 里填真实值。
# 不要提交 config.local.env，里面会有企业微信密钥。

# 企业微信自建应用配置。
# WECOM_CORP_ID：企业 ID，企业微信管理后台可见。
WECOM_CORP_ID=
# WECOM_CORP_SECRET：自建应用 Secret，用于调用企业微信发消息接口。
WECOM_CORP_SECRET=
# WECOM_AGENT_ID：自建应用 AgentId，通常是数字。
WECOM_AGENT_ID=
# WECOM_TOKEN：企业微信“接收消息服务器”里填写的 Token，必须和后台一致。
WECOM_TOKEN=
# WECOM_ENCODING_AES_KEY：企业微信“接收消息服务器”里的 EncodingAESKey，43 位。
WECOM_ENCODING_AES_KEY=
# WECOM_TO_USER：bridge 主动发消息给谁；填你的企业微信 UserID。
WECOM_TO_USER=

# 本机 bridge 服务监听地址。
# 正常只监听 127.0.0.1，不暴露到公网；VPS 通过 SSH 反向隧道转发进来。
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8000
# bridge 自己的管理命令前缀。用 ! 是为了避开 Codex 的 / 命令。
BRIDGE_COMMAND_PREFIX=!

# 安全配置。默认 dev：workspace-write + on-request。
# safe     = read-only + on-request，适合只读诊断。
# dev      = workspace-write + on-request，适合日常开发。
# personal = danger-full-access + never，只适合单人可信机器。
BRIDGE_SECURITY_PROFILE=dev
# 允许哪些企业微信 UserID 控制 bridge。留空时默认只允许 WECOM_TO_USER。
ALLOWED_WECOM_USERS=
# 可选：限制可用 bridge 命令，逗号分隔；留空表示不限制。
ALLOWED_COMMANDS=
# 对会改变 thread/cwd 的 bridge 命令要求手机端二次确认。
DANGEROUS_COMMANDS_REQUIRE_CONFIRMATION=true
# 审计日志。留空可关闭。
BRIDGE_AUDIT_LOG_FILE=logs/audit.jsonl
# 长任务进度推送。默认强调模型明确写出的计划/取舍说明，减少命令和文件噪音。
BRIDGE_FORWARD_THOUGHT_SUMMARY=true
BRIDGE_FORWARD_TOOL_PROGRESS=false
BRIDGE_FORWARD_FILE_CHANGES=false

# Codex 后端。当前项目只保留 remote-control/app-server 路径。
CODEX_BACKEND=codex_remote_control
# Codex app-server 的工作目录；也就是手机发来的任务默认在哪个目录执行。
# 建议填写绝对路径。留空时使用当前启动目录。
CODEX_WORKDIR=
# 单个 Codex turn 最长等待秒数；长 goal 建议至少 1800 秒，避免 bridge 过早判定超时。
CODEX_TIMEOUT_SECONDS=1800
# 固定绑定某个 Codex thread 时填 thread id；留空则使用状态文件里的 thread，或首次消息自动创建。
CODEX_REMOTE_THREAD_ID=
# bridge 保存当前 Codex thread id 的本地文件。
CODEX_REMOTE_STATE_FILE=.codex_wecom_thread_id
# bridge 保存手机端选择的模型覆盖值的本地文件。
CODEX_REMOTE_MODEL_STATE_FILE=.codex_wecom_model
# bridge 保存手机端选择的推理强度覆盖值的本地文件。
CODEX_REMOTE_REASONING_STATE_FILE=.codex_wecom_reasoning
# bridge 保存手机端切换后的默认工作目录。
CODEX_REMOTE_WORKDIR_STATE_FILE=.codex_wecom_workdir
# 默认由 BRIDGE_SECURITY_PROFILE 决定；只有需要覆盖 profile 时才填写。
CODEX_REMOTE_APPROVAL_POLICY=
CODEX_REMOTE_SANDBOX=
# /resume 和 !threads 一次展示最近多少个 Codex thread。微信里太多会难读，建议 10-30。
CODEX_THREAD_LIST_LIMIT=20
# / 命令列表的来源；bridge 会从 Codex 源码读取列表，避免写死。
CODEX_SLASH_COMMANDS_URL=https://raw.githubusercontent.com/openai/codex/main/codex-rs/tui/src/slash_command.rs
# / 命令列表缓存秒数，避免每次发 / 都访问 GitHub。
CODEX_SLASH_COMMANDS_CACHE_SECONDS=21600

# SSH 反向隧道配置。
# 作用：让 VPS 的 127.0.0.1:9800 转发到本机 WSL 的 127.0.0.1:8000。
VPS_HOST=
VPS_USER=
VPS_SSH_PORT=22
# VPS 上 Nginx proxy_pass 连接的地址和端口。
VPS_REMOTE_HOST=127.0.0.1
VPS_REMOTE_PORT=9800
# 本机 bridge 实际监听的地址和端口。
LOCAL_FORWARD_HOST=127.0.0.1
LOCAL_FORWARD_PORT=8000

# WSL 访问 VPS 的代理。
# 如果需要 WSL 直接 SSH 到 VPS，就留空；需要代理时格式为 http://host:port。
SSH_PROXY_URL=
